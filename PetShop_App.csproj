    <Compile Update="Componentes\Notificacoes\DialogoAviso.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Componentes\Notificacoes\DialogoAviso.Designer.cs"><DependentUpon>DialogoAviso.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Componentes\Notificacoes\DialogoAviso.resx"><DependentUpon>DialogoAviso.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Componentes\PainelArredondado.cs"><SubType>Component</SubType></Compile>
  </ItemGroup>
</Project>
