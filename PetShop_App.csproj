    <EmbeddedResource Update="Telas\Pets\PaginaPets.resx"><DependentUpon>PaginaPets.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Telas\Servicos\PaginaServicos.cs"><SubType>UserControl</SubType></Compile>
