<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Dados\" />
    <Folder Include="Modelos\" />
    <Folder Include="Paginas\" />
    <Folder Include="Recursos\" />
    <Folder Include="Telas\Agendamentos\" />
    <Folder Include="Telas\Clientes\" />
    <Folder Include="Telas\Servicos\" />
    <Folder Include="Telas\Vendas\" />
  </ItemGroup>


	<ItemGroup>
		<Compile Update="Telas\Autenticacao\Login.cs">
			<SubType>Form</SubType>
		</Compile>

		<Compile Update="Telas\Autenticacao\Login.Designer.cs">
			<DependentUpon>Login.cs</DependentUpon>
		</Compile>
	</ItemGroup>


	<ItemGroup>
	  <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
	  <PackageReference Include="MySqlConnector" Version="2.4.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Componentes\MenuLateral.cs">
			<SubType>UserControl</SubType>
		</Compile>

		<Compile Update="Componentes\MenuLateral.Designer.cs">
			<DependentUpon>MenuLateral.cs</DependentUpon>
		</Compile>

		<EmbeddedResource Update="Componentes\MenuLateral.resx">
			<DependentUpon>MenuLateral.cs</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>

  <ItemGroup>
    <Compile Update="Telas\Principal\Principal.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Telas\Principal\Principal.Designer.cs"><DependentUpon>Principal.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Telas\Principal\Principal.resx"><DependentUpon>Principal.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Telas\Principal\PainelDiario.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Telas\Principal\PainelDiario.Designer.cs"><DependentUpon>PainelDiario.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Telas\Principal\PainelDiario.resx"><DependentUpon>PainelDiario.cs</DependentUpon></EmbeddedResource>
